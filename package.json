{
  "name": "tree-sitter-kedi",
  "version": "0.3.0",
  "description": "Kedi grammar for tree-sitter",
  "keywords": ["parser", "tree-sitter", "kedi"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kedi-lang/tree-sitter-kedi"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.25.10"
  },
  "tree-sitter": [
    {
      "scope": "source.kedi",
      "file-types": ["kedi"],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm"
    }
  ]
}
